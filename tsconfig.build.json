{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": [
    "src/cli/**/*.ts",
    "src/mcp/**/*.ts",
    "src/server/**/*.ts",
    "src/shared/**/*.ts",
    "src/meta.ts"
  ],
  "exclude": ["dist", "node_modules", "src/web", "test"]
}
