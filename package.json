{
  "name": "@yuske-nakajima/zatto",
  "version": "3.8.1",
  "description": "A local viewer for browsing HTML and Markdown files as one session.",
  "type": "module",
  "license": "MIT",
  "author": "yuske-nakajima",
  "homepage": "https://github.com/yuske-nakajima/zatto#readme",
  "bugs": {
    "url": "https://github.com/yuske-nakajima/zatto/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuske-nakajima/zatto.git"
  },
  "keywords": [
    "html",
    "viewer",
    "preview",
    "local"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "bin",
    "dist",
    "README.ja.md"
  ],
  "bin": {
    "zatto": "bin/zatto.js"
  },
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "pnpm run build:web && pnpm run build:node && pnpm run typecheck",
    "build:node": "tsc -p tsconfig.build.json",
    "build:web": "pnpm run changelog && vite build",
    "changelog": "node scripts/update-changelog.mjs",
    "check": "biome check .",
    "dev:web": "pnpm run changelog && vite",
    "format": "biome format --write .",
    "prepack": "pnpm run build",
    "test": "pnpm run changelog && vitest run",
    "typecheck": "tsc --noEmit && tsc -p video/tsconfig.json",
    "video:render": "pnpm run video:render:en && pnpm run video:render:ja",
    "video:render:en": "remotion render video/index.ts ZattoPv media/zatto-pv.mp4 --codec=h264 --crf=18 --muted --overwrite",
    "video:render:ja": "remotion render video/index.ts ZattoPvJa media/zatto-pv-ja.mp4 --codec=h264 --crf=18 --muted --overwrite",
    "video:render:tour": "remotion render video/index.ts ZattoPvTour media/zatto-pv-tour.mp4 --codec=h264 --crf=18 --muted --overwrite && remotion render video/index.ts ZattoPvTourJa media/zatto-pv-tour-ja.mp4 --codec=h264 --crf=18 --muted --overwrite",
    "video:studio": "remotion studio video/index.ts",
    "verify:package": "pnpm run build && node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.4",
    "@modelcontextprotocol/server": "2.4.0",
    "chokidar": "5.0.0",
    "fastify": "5.12.7",
    "marked": "18.1.1",
    "nanoid": "6.0.2",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@fontsource/biz-udpgothic": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@remotion/cli": "4.0.538",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "github-markdown-css": "5.9.0",
    "jsdom": "30.1.3",
    "mermaid": "12.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.538",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
