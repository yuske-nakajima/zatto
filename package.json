{
  "name": "zatto",
  "version": "0.1.0",
  "description": "A local viewer for browsing HTML files as one session.",
  "type": "module",
  "license": "MIT",
  "author": "yuske-nakajima",
  "homepage": "https://github.com/yuske-nakajima/zatto#readme",
  "bugs": {
    "url": "https://github.com/yuske-nakajima/zatto/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuske-nakajima/zatto.git"
  },
  "keywords": [
    "html",
    "viewer",
    "preview",
    "local"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "bin",
    "dist",
    "README.ja.md"
  ],
  "bin": {
    "zatto": "bin/zatto.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm run build:web && pnpm run build:node && pnpm run typecheck",
    "build:node": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "check": "biome check .",
    "dev:web": "vite",
    "format": "biome format --write .",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:package": "pnpm run build && node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.0",
    "chokidar": "5.0.0",
    "fastify": "5.10.0",
    "nanoid": "6.0.0",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "30.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
